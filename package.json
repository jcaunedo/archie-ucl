{
	"name": "archie-ucl",
	"version": "0.1.0",
	"type": "module",
	"description": "React component library for Archie",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles": "./dist/styles.css"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "tsup && cp src/styles/theme.css dist/styles.css",
		"dev": "tsup --watch",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"motion": "^12.43.0",
		"react-hook-form": "^7.71.2",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.4.1",
		"@storybook/react-vite": "^10.4.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.4.1",
		"tailwindcss": "^4.3.0",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14"
	}
}
